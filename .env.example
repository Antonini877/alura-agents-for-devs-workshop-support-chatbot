# Copie este arquivo para .env e preencha sua chave da Google AI Studio

# Chave da API do Google Generative AI (Gemini)
GOOGLE_API_KEY=coloque_sua_chave_aqui

# Modelo Gemini a ser utilizado
MODEL_NAME=gemini-2.0-flash

LANGCHAIN_API_KEY=coloque_sua_chave_aqui
LANGCHAIN_ENDPOINT=
LANGCHAIN_TRACING_V2=

# Configurações de e-mail para a tool do commercial_bot
# Preencha com credenciais válidas do provedor (ex.: Gmail)
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false

# Dica (Gmail): se 2FA estiver ativado, crie uma "senha de app" e
# use-a em EMAIL_PASS. Se usar SSL direto, defina SMTP_PORT=465 e SMTP_SSL=true.
